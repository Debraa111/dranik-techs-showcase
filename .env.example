# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env — it is ignored by git.

# --- Database (PostgreSQL, e.g. a Supabase project) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: a separate database for the e2e tests. If unset, e2e tests are skipped
# and the app's in-memory store is used, so production data is never touched.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE

# --- Supabase Auth (public values, also bundled into the mobile app) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Secret, server only. Optional: only needed to permanently delete auth users.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- API server ---
PORT=3000
# Where the mobile app finds the API. Leave empty in local dev to auto-detect.
EXPO_PUBLIC_API_BASE_URL=
# Extra comma-separated CORS origins, e.g. a tunnel URL used for testing.
ALLOWED_ORIGINS=

# --- Admin bootstrap: this email becomes an admin on first sign-in ---
OWNER_EMAIL=you@example.com
OWNER_NAME=Your Name

# --- Payments ---
# "mock" records payments without charging; "paystack" uses the Paystack gateway.
PAYMENT_GATEWAY=mock
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY

# --- Escrow release codes: random secret used to hash codes (e.g. `openssl rand -hex 32`) ---
RELEASE_CODE_PEPPER=YOUR_RANDOM_SECRET

# --- Optional platform services (image generation / storage proxy) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
